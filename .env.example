# WithYou Novel 环境变量配置
# 复制此文件为 .env.local 并填入你的真实密钥
# .env.local 不会被打包进 exe；安装版运行时从用户数据目录读取：
# %APPDATA%\\WithYou Novel\\.env.local

# Supabase 配置
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AGNES 图片生成 API
AGNES_API_KEY=your-agnes-api-key

# StepFun API Keys
STEPFUN_KEY_DISPATCH=your-stepfun-dispatch-key
STEPFUN_KEY_CHAT=your-stepfun-chat-key
STEPFUN_KEY_TOOL=your-stepfun-tool-key
STEPFUN_KEY_WRITE=your-stepfun-write-key
