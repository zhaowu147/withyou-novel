{
  "name": "withyou-novel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "project:status": "node scripts/project-status.mjs",
    "test:security": "tsx --test tests/project-path.test.ts tests/request-guards.test.ts tests/prompt-boundary.test.ts",
    "test": "tsx --conditions=react-server --test tests/project-path.test.ts tests/request-guards.test.ts tests/prompt-boundary.test.ts tests/app-paths.test.ts tests/field-map.test.ts tests/json-db.test.ts tests/context-compressor.test.ts tests/local-origin-guard.test.ts tests/provenance.test.ts tests/alias-registry.test.ts tests/server-novel-data.test.ts tests/entity-alias-store.test.ts tests/consolidation-depth.test.ts tests/project-scaffold.test.ts tests/openai-stream.test.ts tests/transport-errors.test.ts tests/semantic-alignment.test.ts tests/form-fill.test.ts tests/task-entry.test.ts tests/sse-client.test.ts tests/prompt-store.test.ts tests/semantic-contract-store.test.ts tests/coding-agent.test.ts tests/project-api-tools.test.ts tests/project-api-runtime.test.ts tests/source-skill-catalog.test.ts tests/source-skill-manager.test.ts",
    "electron:dev": "electron electron",
    "electron:runtime": "node scripts/prepare-electron-runtime.mjs",
    "electron:build": "pnpm build && pnpm electron:runtime && electron-builder --projectDir electron --win",
    "electron:build:dir": "pnpm build && electron-builder --win --dir"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.2",
    "chalk": "5.6.2",
    "cheerio": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-spawn": "7.0.6",
    "d3-force": "^3.0.0",
    "date-fns": "^4.4.0",
    "diff": "8.0.4",
    "docx": "^9.5.1",
    "embla-carousel-react": "^8.6.0",
    "file-saver": "^2.0.5",
    "geist": "^1.7.2",
    "glob": "13.0.6",
    "highlight.js": "10.7.3",
    "hosted-git-info": "9.0.3",
    "ignore": "7.0.5",
    "input-otp": "^1.4.2",
    "jiti": "2.7.0",
    "lucide-react": "^1.21.0",
    "minimatch": "10.2.5",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "proper-lockfile": "4.1.2",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.0",
    "semver": "7.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "simple-icons": "^16.24.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.128.0",
    "typebox": "^1.1.38",
    "undici": "^8.9.0",
    "vaul": "^1.1.2",
    "yaml": "2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild", "@google/genai", "protobufjs", "electron-winstaller"],
    "overrides": {
      "ajv>fast-uri": "3.1.4",
      "cheerio>undici": "6.28.0",
      "minimatch>brace-expansion": "5.0.8",
      "next>postcss": "8.5.23",
      "next>sharp": "0.35.3",
      "shadcn>postcss": "8.5.23"
    },
    "ignoredBuiltDependencies": ["@google/genai", "electron", "electron-winstaller", "esbuild", "protobufjs"]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/d3-force": "^3.0.10",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.20.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.withyou.novel",
    "productName": "WithYou Novel",
    "directories": {
      "output": "release"
    },
    "files": ["electron/**/*", ".next/standalone/**/*", "public/**/*", "package.json"],
    "extraMetadata": {
      "dependencies": {},
      "devDependencies": {}
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/public"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WithYou Novel"
    }
  }
}
